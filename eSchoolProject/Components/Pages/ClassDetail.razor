@page "/class/{ClassId:long}"
@using eSchoolDatabase.ViewModels
@using eSchoolProject.Components.Component


<MudPaper Class="pa-4">
	<div class="tab-container">
		<div class="tab-content">

			<MudDataGrid Items="@ClassStudents">
				<ToolBarContent>
					<MudText Typo="Typo.h6">@SelectedClass?.ClassLevel @SelectedClass?.Section Sınıf Öğrencileri</MudText>
					<MudSpacer />
					<div class="add-button-management">
						<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenPopup">
							Öğrenci Ekle
						</MudButton>
					</div>
				</ToolBarContent>
				<Columns>
					<PropertyColumn Property="x => x.Name" Title="Name" />
					<PropertyColumn Property="x => x.StudentNumber" Title="Student number" />
					<PropertyColumn Property="x => x.IdentityNumber" Title="Identity number" />
					<PropertyColumn Property="x => x.ParentNumber" Title="Parent number" />
				</Columns>
			</MudDataGrid>
		</div>
	</div>
</MudPaper>
<Popup IsVisible="IsAddStudentPopupOpen" PopupClosed="ClosePopup">
	<Body>
		<MudSelect T="StudentViewModel"
				   SelectedValues="SelectedStudents"
				   SelectedValuesChanged="OnSelectedStudentsChanged"
				   MultiSelection="true"
				   Label="Öğrenci Seçin"
				   ToStringFunc="@(s => s.Name + " (" + s.StudentNumber + ")")">
			@foreach (var student in UnassignedStudents)
			{
				<MudSelectItem Value="student">@student.Name (@student.StudentNumber)</MudSelectItem>
			}
		</MudSelect>
		<div class="popup-actions">
			<MudButton Color="Color.Primary" OnClick="AddStudentToClassAsync">Ekle</MudButton>
			<MudButton OnClick="() => IsAddStudentPopupOpen = false">İptal</MudButton>
		</div>

	</Body>
</Popup>
