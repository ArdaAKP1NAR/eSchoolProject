@page "/RegistrationProcedures/{SchoolId:long}"
@using eSchoolDatabase.ViewModels

<MudCard Elevation="2" Class="mud-card-registration">
	<div class="m-3">
		<div class="text-alignment">
			<h3>Registration Procedures</h3>
		</div>
		<div class="ard-tabcontainer">
			<div @onclick="@(() => SetActiveTab("ClassProcedures"))" class=@((ActiveTab == "ClassProcedures" ? "tab-button-active" : "tab-button") + " tab-button-spacing" )>
				<div class="tab-button-design">
					Class Procedures
				</div>
			</div>
			<div @onclick="@(() => SetActiveTab("LessonProcedures"))" class=@((ActiveTab == "LessonProcedures" ? "tab-button-active" : "tab-button") + " tab-button-spacing" )>
				<div class="tab-button-design">
					Lesson Procedures
				</div>
			</div>
		</div>
		@if (ActiveTab == "ClassProcedures")
		{
			<div class="tab-container">
				<div class="tab-content">
					<div class="class-container">
						<MudText Typo="Typo.h6" Class="mud-width-full"><h3>Class Registration</h3></MudText>
						<MudSelect T="ClassViewModel" Value="selectedClass" Label="Choose class" ValueChanged="OnClassChanged">
							@foreach (var classView in classList)
							{
								<MudSelectItem T="ClassViewModel" Value="@classView">@classView.ClassName</MudSelectItem>
							}
						</MudSelect>
						<MudSelect T="long" Label="Students" HelperText="Choose students to register to class" MultiSelection="true" @bind-SelectedValues="selectedStudentIds">
							@foreach (var student in studentList)
							{
								<MudSelectItem T="long" Value="@student.Id">@student.Name</MudSelectItem>
							}
						</MudSelect>
						@if (selectedClass != null)
						{
							<div class="buttons-alignment">
								<MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelSelections">
									Cancel
								</MudButton>
								<MudButton Class="register-button" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
										   OnClick="() => AddStudentToClassAsync(selectedClass.Id)" />
							</div>
						}
					</div>
				</div>
			</div>
		}
		@if (ActiveTab == "LessonProcedures")
		{
			<div class="tab-container">
				<div class="tab-content">
					<MudDataGrid SortMode="SortMode.Multiple" Filterable="true" Hideable="true" Items="@lessonList">
						<ToolBarContent>
							<MudText Typo="Typo.h6">Lesson List</MudText>
							<MudSpacer />
							<div class="add-button-management">
								<MudButton Class="add-button" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenLessonPopup" />
							</div>
						</ToolBarContent>
						<Columns>
							<PropertyColumn Property="x => x.Name" Title="Name" />
						</Columns>
					</MudDataGrid>
				</div>
			</div>
		}
	</div>
</MudCard>

<LessonManagementPopup  IsLessonPopupVisible="IsLessonPopupVisible"
						SchoolId="SchoolId"
						PopupClosed="() => {IsLessonPopupVisible = false;}"
						SaveClicked="OnSavedAsync" />
