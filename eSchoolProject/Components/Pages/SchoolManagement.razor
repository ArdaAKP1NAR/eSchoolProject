@page "/SchoolManagement/{SchoolId:long}"
@using eSchoolDatabase.ViewModels.GridViewModels
@if (schoolViewModel != null)
{
	<MudCard Elevation="2">
		<div class="m-3">
			<h3>School Overview: @schoolViewModel.Name</h3>
			<LabelComponent Label="City">
				@schoolViewModel.Address.City
			</LabelComponent>
			<LabelComponent Label="District">
				@schoolViewModel.Address.District
			</LabelComponent>
			<LabelComponent Label="Street">
				@schoolViewModel.Address.Street
			</LabelComponent>

			<div class="ard-tabcontainer">
				<div @onclick="@(() => SetActiveTab("Managers"))" class=@((ActiveTab == "Managers" ? "tab-button-active" : "tab-button") + " tab-button-spacing" )>
					<div class="tab-button-design">
						Managers
					</div>
				</div>
				<div @onclick="@(() => SetActiveTab("Teachers"))" class=@((ActiveTab == "Teachers" ? "tab-button-active" : "tab-button") + " tab-button-spacing" )>
					<div class="tab-button-design">
						Teachers
					</div>
				</div>
				<div @onclick="@(() => SetActiveTab("Students"))" class=@((ActiveTab == "Students" ? "tab-button-active" : "tab-button") + " tab-button-spacing" )>
					<div class="tab-button-design">
						Students
					</div>
				</div>
				<div @onclick="@(() => SetActiveTab("Classes"))" class=@((ActiveTab == "Classes" ? "tab-button-active" : "tab-button") + " tab-button-spacing" )>
					<div class="tab-button-design">
						Classes
					</div>
				</div>
			</div>

			@if (ActiveTab == "Managers")
			{
				<div class="tab-container">
					<div class="tab-content">
						<MudDataGrid @ref="MudDataGridManagers" T="ManagerGridView" ServerData="LoadManager" SortMode="SortMode.Multiple" Filterable="true">
							<ToolBarContent>
								<MudText Typo="Typo.h6">Manager List</MudText>
								<MudSpacer />
								<div class="add-button-management">
									<MudButton Class="add-button" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNewManager">Add Manager</MudButton>
								</div>
							</ToolBarContent>
							<Columns>
								<PropertyColumn Property="x => x.Name" Title="Name" />
								<PropertyColumn Property="x => x.PhoneNumber" Title="Phone number" />
								<TemplateColumn Title="Update Manager">
									<CellTemplate>
										<MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Edit" OnClick=" () => OpenManagerPopupFromViewModel(context.Item)">
											Update
										</MudButton>
									</CellTemplate>
								</TemplateColumn>
							</Columns>
						</MudDataGrid>
					</div>
				</div>
			}
			@if (ActiveTab == "Teachers")
			{
				<div class="tab-container">
					<div class="tab-content">
						<MudDataGrid @ref="MudDataGridTeachers" T="TeacherGridView" ServerData="LoadTeacher" SortMode="SortMode.Multiple" Filterable="true">
							<ToolBarContent>
								<MudText Typo="Typo.h6">Teacher List</MudText>
								<MudSpacer />
								<div class="add-button-management">
									<MudButton Class="add-button" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNewTeacher">Add Teacher</MudButton>
								</div>
							</ToolBarContent>
							<Columns>
								<PropertyColumn Property="x => x.Name" Title="Name" />
								<PropertyColumn Property="x => x.PhoneNumber" Title="Phone number" />
								<TemplateColumn Title="School Overview">
									<CellTemplate>
										<MudButton Variant="Variant.Outlined" Color="Color.Dark" StartIcon="@Icons.Material.Filled.ChevronRight"
												   OnClick="() => NavigateToGradePanel(context.Item.Id)">
											Grade Panel
										</MudButton>
									</CellTemplate>
								</TemplateColumn>
								<TemplateColumn Title="School Overview">
									<CellTemplate>
										<MudButton Variant="Variant.Outlined" Color="Color.Dark" StartIcon="@Icons.Material.Filled.ChevronRight"
												   OnClick="() => NavigateToAttendance(context.Item.Id)">
											Attendance
										</MudButton>
									</CellTemplate>
								</TemplateColumn>
							
								<TemplateColumn Title="Update Teacher">
									<CellTemplate>
										<MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Edit" OnClick=" () => OpenTeacherPopupFromViewModel(context.Item)">
											Update
										</MudButton>
									</CellTemplate>
								</TemplateColumn>
							</Columns>
						</MudDataGrid>
					</div>
				</div>
			}
			@if (ActiveTab == "Students")
			{
				<div class="tab-container">
					<div class="tab-content">
						<MudDataGrid @ref="MudDataGridStudents" T="StudentGridView" ServerData="LoadStudent" SortMode="SortMode.Multiple" Filterable="true">
							<ToolBarContent>
								<MudText Typo="Typo.h6">Student List</MudText>
								<MudSpacer />
								<div class="add-button-management">
									<MudButton Class="add-button" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNewStudent">Add Student</MudButton>
								</div>
							</ToolBarContent>
							<Columns>
								<PropertyColumn Property="x => x.Name" Title="Name" />
								<PropertyColumn Property="x => x.StudentNumber" Title="Student number" />
								<PropertyColumn Property="x => x.IdentityNumber" Title="Identity number" />
								<PropertyColumn Property="x => x.ParentNumber" Title="Parent number" />
								<PropertyColumn Property="x => x.BirthdayDate" Title="Birthday date" Format="dd/MM/yyyy" />
								<PropertyColumn Property="x => x.Address.District" Title="District" />
								<PropertyColumn Property="x => x.Address.Street" Title="Street" />
								<TemplateColumn Title="Update Student">
									<CellTemplate>
										<MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Edit" OnClick=" () => OpenStudentPopupFromViewModel(context.Item)">
											Update
										</MudButton>
									</CellTemplate>
								</TemplateColumn>
							</Columns>
						</MudDataGrid>
					</div>
				</div>
			}
			@if (ActiveTab == "Classes") // gerekli eklemeler yapılacak
			{
				<div class="tab-container">
					<div class="tab-content">
						<MudDataGrid @ref="MudDataGridClasses" T="ClassGridView" ServerData="LoadClass" SortMode="SortMode.Multiple" Filterable="true">
							<ToolBarContent>
								<div class="grid-header">
									<MudText Typo="Typo.h6">Class List</MudText>
									<MudSpacer />
									<div class="button-container">
										<div class="add-button-management">
											<MudButton Class="add-button" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenLessonPopup">Add Lesson</MudButton>
										</div>
										<div class="add-button-management">
											<MudButton Class="add-button" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenClassPopup">Add Class</MudButton>
										</div>
									</div>	
								</div>
							</ToolBarContent>
							<Columns>
								<PropertyColumn Property="x => x.FullClassName" Title="Name" />
								<TemplateColumn Title="Class Detail">
									<CellTemplate>
										<MudButton Variant="Variant.Outlined" Color="Color.Dark" StartIcon="@Icons.Material.Filled.ChevronRight"
												   OnClick="() => NavigateToClassDetail(context.Item.Id)">
											Class Information & Processes
										</MudButton>
									</CellTemplate>
								</TemplateColumn>
								<TemplateColumn Title="Lesson Schedule">
									<CellTemplate>
										<MudButton Variant="Variant.Outlined" Color="Color.Dark" StartIcon="@Icons.Material.Filled.ChevronRight"
												   OnClick="() => NavigateToSchedule(context.Item.SchoolId)">
											Lesson Schedule
										</MudButton>
									</CellTemplate>
								</TemplateColumn>
							</Columns>

						</MudDataGrid>
					</div>
				</div>
			}
		</div>
	</MudCard>

	<ManagerManagementPopup @ref=ManagerManagementPopup
							SchoolId="SchoolId"
							SaveClicked="OnSavedAsync" />
	<TeacherManagementPopup @ref=TeacherManagementPopup
							SchoolId="SchoolId"
							SaveClicked="OnSavedAsync" />
	<StudentManagementPopup @ref=StudentManagementPopup
							SchoolId="SchoolId"
							SaveClicked="OnSavedAsync" />
	<ClassManagementPopup IsClassPopupVisible="IsClassPopupVisible"
						  SchoolId="SchoolId"
						  PopupClosed="() => {IsClassPopupVisible = false;}"
						  SaveClicked="OnSavedAsync" />
	<LessonManagementPopup IsLessonPopupVisible="IsLessonPopupVisible"
						   SchoolId="SchoolId"
						   PopupClosed="() => { IsLessonPopupVisible = false; }"
						   SaveClicked="OnSavedAsync" />

}