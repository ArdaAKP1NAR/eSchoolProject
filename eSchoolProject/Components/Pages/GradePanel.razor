@page "/gradepanel/{TeacherId:long}"
@using eSchoolDatabase.ViewModels
<MudPaper Class="pa-4">
	<div class="select-container grade-panel-select gap-1">
		<MudSelect Placeholder="Sinif secin" Variant="Variant.Outlined" Label="Sınıf Seçin" @bind-Value="SelectedClass" @bind-Value:after=LoadLessons>
			@foreach (var sinif in ClassList)
			{
				<MudSelectItem Value="@sinif">@($"{sinif.ClassLevel} {sinif.Section}")</MudSelectItem>
			}
		</MudSelect>
		@if (SelectedClass != null)
		{
			<MudSelect T="LessonViewModel"
					   Value="SelectedLesson"
					   ValueChanged="OnSelectedLessonChanged"
					   Class="ms-1"
					   Label="Ders Seçin"
					   Variant="Variant.Outlined">
				@foreach (var lesson in SelectedClassLessons)
				{
					<MudSelectItem Value="@lesson">@lesson.Name</MudSelectItem>
				}
			</MudSelect>
		}
	</div>
	<div class="tab-container">
		<div class="tab-content">
			<div class="grade-panel">
				<MudDataGrid Items="@SelectedClassStudents" T="StudentViewModel" Hover="true" Bordered="true">
					<ToolBarContent>
						<MudText Typo="Typo.h6">
							Students of Class @SelectedClass?.ClassLevel @SelectedClass?.Section
						</MudText>
						<div class="select-container ms-2">
						</div>
						<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="SaveGradesAsync">
							Save Grades
						</MudButton>
					</ToolBarContent>
					<Columns>
						<PropertyColumn Property="x => x.Name" Title="Name" />
						<PropertyColumn Property="x => x.StudentNumber" Title="Student Number" />
						<PropertyColumn Property="x => x.IdentityNumber" Title="Identity Number" />
						<TemplateColumn Title="Midterm">
							<CellTemplate>
								<MudNumericField HideSpinButtons="true" Variant="Variant.Outlined" @bind-Value="context.Item.Midterm" Max="100" Min="0" Style="width: 100px;" />
							</CellTemplate>
						</TemplateColumn>
						<TemplateColumn Title="Final">
							<CellTemplate>
								<MudNumericField HideSpinButtons="true" Variant="Variant.Outlined" @bind-Value="context.Item.Final" Max="100" Min="0" Style="width: 100px;" />
							</CellTemplate>
						</TemplateColumn>
						<TemplateColumn Title="Oral">
							<CellTemplate>
								<MudNumericField HideSpinButtons="true" Variant="Variant.Outlined" @bind-Value="context.Item.Oral" Max="100" Min="0" Style="width: 100px;" />
							</CellTemplate>
						</TemplateColumn>
						<TemplateColumn Title="Homework">
							<CellTemplate>
								<MudNumericField HideSpinButtons="true" Variant="Variant.Outlined" @bind-Value="context.Item.Homework" Max="100" Min="0" Style="width: 100px;" />
							</CellTemplate>
						</TemplateColumn>
						<PropertyColumn Property="x => x.Average" Title="Average" />
					</Columns>
				</MudDataGrid>
			</div>
		</div>
	</div>
</MudPaper>