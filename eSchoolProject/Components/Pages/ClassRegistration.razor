@page "/ClassRegistration/{SchoolId:long}"
@using eSchoolDatabase.ViewModels

<div class="class-container">
	<MudText Typo="Typo.h6" Class="mud-width-full"><h3>Class Registration</h3></MudText>
	<MudSelect T="ClassViewModel" Value="selectedClass" Label="Choose class" ValueChanged="OnClassChanged">
		@foreach (var classView in classList)
		{
			<MudSelectItem T="ClassViewModel" Value="@classView">@classView.ClassName</MudSelectItem>
		}
	</MudSelect>
	<MudSelect T="long" Label="Students" HelperText="Choose students to register to class" MultiSelection="true" @bind-SelectedValues="selectedStudentIds">
		@foreach (var student in studentList)
		{
			<MudSelectItem T="long" Value="@student.Id">@student.Name</MudSelectItem>
		}
	</MudSelect>
	@if (selectedClass != null)
	{
		<div class="buttons-alignment">
			<MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelSelections">
				Cancel
			</MudButton>
			<MudButton Class="register-button" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
					   OnClick="() => AddStudentToClassAsync(selectedClass.Id)" />
		</div>
	}
</div>

