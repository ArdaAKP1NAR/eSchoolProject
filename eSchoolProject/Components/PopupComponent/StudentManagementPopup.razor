@using Blazored.FluentValidation
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<Popup IsVisible="IsStudentPopupVisible" PopupClosed="ClosePopupAsync">
	<Body>
		@if (StudentViewModel != null && SchoolId != 0)
		{
			<h3>@(StudentViewModel.Id != 0 ? "Update Student" : "Add Student")</h3> <!-- Başlık Dinamik -->
			<EditForm OnValidSubmit="@((StudentViewModel.Id != 0) ? UpdateStudentAsync : AddStudentAsync)" Model="StudentViewModel">
				<FluentValidationValidator Options="@(options => options.IncludeAllRuleSets())" />

				@if (StudentViewModel.Id == 0)
				{
					<MudTextField @bind-Value=StudentViewModel.Name For="@(() => StudentViewModel.Name)" Label="Name" />
					<MudTextField @bind-Value=StudentViewModel.IdentityNumber For="@(() => StudentViewModel.IdentityNumber)" Label="Identity number" />
					<MudDatePicker @bind-Date="StudentViewModel.BirthdayDate" Label="Birthday date" />
					<MudTextField @bind-Value=StudentViewModel.StudentNumber For="@(() => StudentViewModel.StudentNumber)" Label="Student number" />
				}
				<MudTextField @bind-Value=StudentViewModel.ParentNumber For="@(() => StudentViewModel.ParentNumber)" Label="Parent number" />
				<MudTextField @bind-Value="StudentViewModel.Address.City" For="@(() => StudentViewModel.Address.City)" Label="City" />
				<MudTextField @bind-Value="StudentViewModel.Address.District" For="@(() => StudentViewModel.Address.District)" Label="District" />
				<MudTextField @bind-Value="StudentViewModel.Address.Street" For="@(() => StudentViewModel.Address.Street)" Label="Street" />
				<div class="popup-actions">
					<MudButton Color="Color.Secondary" Variant="Variant.Filled" ButtonType="ButtonType.Button" OnClick="ClosePopupAsync">Cancel</MudButton>
					<MudButton Color="Color.Success" Variant="Variant.Filled" ButtonType="ButtonType.Submit">
						@(StudentViewModel.Id != 0 ? "Update Student" : "Add Student")</MudButton>
				</div>
			</EditForm>
		}
	</Body>
</Popup>
