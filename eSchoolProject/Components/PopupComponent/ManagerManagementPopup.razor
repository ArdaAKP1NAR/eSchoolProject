@using Blazored.FluentValidation
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<Popup IsVisible="IsManagerPopupVisible" PopupClosed="Close">
	<Body>
		@if (ManagerRequestModel != null || SchoolId != 0)
		{
			<EditForm OnValidSubmit="AddManagerAsync" Model="ManagerRequestModel">
				<FluentValidationValidator Options="@(options => options.IncludeAllRuleSets())" />
				<h3>Add School</h3>
				<MudTextField @bind-Value=ManagerRequestModel.Name For="@(() => ManagerRequestModel.Name)" Label="Manager name:" Variant="Variant.Text" />
				<MudTextField @bind-Value="ManagerRequestModel.IdentityNumber" For="@(() => ManagerRequestModel.IdentityNumber)" Label="IdentityNumber" Variant="Variant.Text" />
				<MudTextField @bind-Value="ManagerRequestModel.Password" For="@(() => ManagerRequestModel.Password)" Label="Password" Variant="Variant.Text" 
					InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon"
							  OnAdornmentClick="PasswordVisibility" AdornmentAriaLabel="Show Password" />

				<div class="popup-actions">
					<MudButton Color="Color.Secondary" Variant="Variant.Filled" ButtonType="ButtonType.Button" OnClick="Close">Cancel</MudButton>
					<MudButton Color="Color.Success" Variant="Variant.Filled" ButtonType="ButtonType.Submit">Add</MudButton>
				</div>
			</EditForm>
		}
	</Body>
</Popup>

