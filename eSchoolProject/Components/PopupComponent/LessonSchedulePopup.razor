@using MudBlazor
@using eSchoolDatabase.RequestModels
@using eSchoolProject.Services.IServices

<Popup IsVisible="IsLessonSchedulePopupVisible" PopupClosed="ClosePopupAsync">
    <Body>
        @if (RequestModel != null)
        {
            <h3>@(RequestModel.Id != 0 ? "Ders Programı Güncelle" : "Ders Programı Ekle")</h3>

            <EditForm Model="RequestModel" OnValidSubmit="SaveScheduleAsync">
                <MudTextField Label="Sınıf" Value="@ClassList.FirstOrDefault(c => c.Id == RequestModel.ClassId)?.FullClassName" Disabled="true" />


                <MudSelect Label="Öğretmen Seç" @bind-Value="RequestModel.Teacher" >
                    @foreach (var teacher in TeachersForSelectedClass)
                    {
                        <MudSelectItem Value="@teacher">@teacher.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect Label="Ders Seç" @bind-Value="RequestModel.Lesson" Disabled="@(!LessonsForSelectedTeacher.Any())">
                    @foreach (var lesson in LessonsForSelectedTeacher)
                    {
                        <MudSelectItem Value="@lesson">@lesson.Name</MudSelectItem>
                    }
                </MudSelect>


                <MudTextField Label="Gün" @bind-Value="RequestModel.Day" Disabled="true" />

                <MudTextField Label="Saat" @bind-Value="RequestModel.StartTime" Disabled="true" />

                <div class="popup-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" ButtonType="ButtonType.Button" OnClick="ClosePopupAsync">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" ButtonType="ButtonType.Submit">
                        @(RequestModel.Id != 0 ? "Güncelle" : "Ekle")
                    </MudButton>
                </div>
            </EditForm>
        }
    </Body>
</Popup>
