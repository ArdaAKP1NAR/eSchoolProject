@using Blazored.FluentValidation
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using eSchoolDatabase.ViewModels

<Popup IsVisible="IsLessonPopupVisible" PopupClosed="Close">
	<Body>
		@if (LessonRequestModel != null && SchoolId != 0)
		{
			<h3>Add lesson</h3>
			<EditForm OnValidSubmit="AddLessonAsync" Model="LessonRequestModel">
				<FluentValidationValidator Validator="validationRules"  />
				<MudSelect T="ClassViewModel"
						   SelectedValues="LessonRequestModel.ClassList"
						   SelectedValuesChanged="(IEnumerable<ClassViewModel> selected) => {LessonRequestModel.ClassList = selected.ToList();}"
						   MultiSelection="true"
						   Label="Select class"
						   ToStringFunc="@(s => s.FullClassName)">
					@foreach (var classView in classList)
					{
						<MudSelectItem Value="classView">@classView.FullClassName</MudSelectItem>
					}
				</MudSelect>
				<MudSelect @bind-Value="LessonRequestModel.Teacher" Label="Select teacher">
					@foreach (var teacher in teacherList)
					{
						<MudSelectItem Value="@teacher">@teacher.Name</MudSelectItem>
					}
				</MudSelect>

				<MudTextField @bind-Value=LessonRequestModel.Name For="@(() => LessonRequestModel.Name)" Label="Name" />
				<MudTextField @bind-Value=LessonRequestModel.CourseCode For="@(() => LessonRequestModel.CourseCode)" Label="Course code" />

				<div class="popup-actions">
					<MudButton Color="Color.Secondary" Variant="Variant.Filled" ButtonType="ButtonType.Button" OnClick="Close">Cancel</MudButton>
					<MudButton Color="Color.Success" Variant="Variant.Filled" ButtonType="ButtonType.Submit">Add</MudButton>
				</div>
			</EditForm>
		}
	</Body>
</Popup>

